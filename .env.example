# Server Port
PORT=3000

# Environment mode (development / production / test)
NODE_ENV=development

# Admin Secret Key for API and Dashboard operations
ADMIN_API_KEY=admin-secret-key-2026

# Rate Limiting Configuration
# Window duration in milliseconds (e.g. 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum allowed requests per IP in the window
RATE_LIMIT_MAX_REQUESTS=100

# Number of rate-limit violations before temporary IP block is triggered
VIOLATION_THRESHOLD=3

# Duration of temporary IP block in milliseconds (e.g. 300000 = 5 minutes)
BLOCK_DURATION_MS=300000

# Reverse Proxy Trust Configuration ('true', 'false', or number of hops)
# Set to 'false' to prevent spoofed X-Forwarded-For headers
TRUST_PROXY=false

# Max request logs retained in JSON database before FIFO rotation
MAX_REQUEST_LOGS=10000
